FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object thermophysicalProperties.liquid;
} 
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       tabulated;
    thermo          hTabulated;
    equationOfState icoTabulated;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        molWeight   18;  
    }
    equationOfState
    {
        rho 997.0; // Water at 300 K, for Re = 200 with U = 0.853 m/s
    }
    thermodynamics
    {
        Cp          4179.0;
        Hf 0;
        Tref 300.0;
        Href 0;
    }
    transport
    {
        mu          8.5e-4;
        Pr          5.8;
    }
}


