FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant/fluid";
    object thermophysicalProperties.gas;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState perfectGas;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        molWeight   18.015;
    }
    thermodynamics
    {
        Cp          2030;
        Hf 0;
        Tref 373.15;
        Href 2260000;
        Sf          0;
    }
    transport
    {
        mu          1.22e-5;
        Pr          1.0;
    }
}

dpdt off;

// ************************************************************************* //