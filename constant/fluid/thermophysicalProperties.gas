FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant/fluid";
    object thermophysicalProperties.gas;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       tabulated;
    thermo          hTabulated;
    equationOfState perfectGas;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        molWeight   18.015;
    }
    thermodynamics
    {
        Hf 2260000; // vapor enthalpy offset relative to liquid at Tsat
        Sf          0;
        Cp ((373.15 2030) (423.15 2050) (473.15 2100));
    }
    transport
    {
        mu ((373.15 1.22e-5) (423.15 1.35e-5) (473.15 1.48e-5));
        kappa ((373.15 0.025) (423.15 0.030) (473.15 0.035));
    }
}

dpdt off;

// ************************************************************************* //
