FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heSolidThermo;
    mixture         pureMixture;
    transport       constIso;
    thermo          hConst;
    equationOfState rhoConst;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie { molWeight 63.546; }     // Masa molar del Cobre
    transport { kappa 401; }          // Conductividad del Cobre (401 W/m K)
    thermodynamics { Hf 0; Cp 385; }  // Calor específico del Cobre (385 J/kg K)
    equationOfState { rho 8960; }     // Densidad del Cobre (8960 kg/m3)
}
