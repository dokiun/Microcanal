FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/fluid";
    object      alpha.water;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

//internalField   nonuniform List<scalar> 
//990000 son como una malla que ya se habia hecho

internalField uniform 1; //que ese valor de alpha será 1 en todo lugar (agua)

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 1;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform 1;
        value           uniform 1;
    }

    outerRight
    {
        type            symmetryPlane;
    }

    outerLeft
    {
        type            symmetryPlane;
    }

    fluid_to_solid
    {
        type            zeroGradient;
    }
}

// ************************************************************************* //
