FoamFile
{
    version 2.0;
    format ascii;
    class volVectorField;
    object U.liquid;
}

dimensions [0 1 -1 0 0 0 0];
internalField uniform (0 0 0.428);
boundaryField
{
    outerLeft
    {
        type symmetryPlane;
    }
    outerRight
    {
        type symmetryPlane;
    }
    inlet
    {
        type flowRateInletVelocity;
        massFlowRate constant 2.57e-5;
        rhoInlet 997.0;
        value uniform (0 0 0.426);
    }
    outlet
    {
        type pressureInletOutletVelocity; 
        phi phi.liquid; 
        value uniform (0 0 0);
    }
    fluid_to_solid
    {
        type noSlip;
    }
}
