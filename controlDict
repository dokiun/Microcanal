FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     multiRegionPhaseChangeFlow;
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         0.1; //0.042; //1.0;
deltaT          1.00e-8;
writeControl    adjustableRunTime;
writeInterval   1e-2;
purgeWrite      10;
writeFormat     binary;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   10;
runTimeModifiable yes;
adjustTimeStep  yes;
maxCo           0.1999;
maxAlphaCo      0.1999;
maxDeltaT       4.00e-6; //4.00e-6;
maxDi           100;
maxCapillaryNum 1;

libs
(
    "libpostProcess.so"
    "libfluidThermo.so"
	"libOpenFOAM.so"
);

