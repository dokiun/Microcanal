################################################################################
#  Caso: channel3D121026
#  Solver: multiRegionPhaseChangeFlow (OpenFOAM 2412)
#  Fecha: 2026-10-13
################################################################################

################################################################################
# 1. IDENTIFICACION DEL CASO
################################################################################

Nombre_caso             channel3D121026
Solver                  multiRegionPhaseChangeFlow
Version_OpenFOAM        2412
Regiones                fluid  solid

################################################################################
# 2. GEOMETRIA DEL DOMINIO
################################################################################

# --- Sistema de coordenadas ---
# X  = direccion transversal (ancho del canal)
# Y  = direccion vertical    (alto del canal)
# Z  = direccion de flujo    (longitud del canal)

# --- Canal fluido ---
W_canal_fluido          1.50e-4   m    # 150 µm
H_canal_fluido          3.00e-4   m    # 300 µm
L_total                 1.00e-2   m    # 10.0 mm
L_calentada             8.80e-3   m    # 10.0 mm

A_seccion_transversal   4.50e-8   m2   # W x H = 150e-6 x 300e-6
Perimetro_mojado        9.00e-4   m    # 2(W+H)
Dh_hidraulico           2.00e-4   m    # 200 µm = 4*A/P

# --- Solido (silicio) ---
W_pared_lat             7.50e-5   m    # 75 µm (cada lado)
H_pared_inf_sup         1.00e-4   m    # 100 µm (top y bottom)
W_solido_total          3.00e-4   m    # 300 µm = 2*75 + 150
H_solido_total          5.00e-4   m    # 500 µm = 2*100 + 300

A_base_total            3.00e-6   m2   # W_solido_total x L_total

# --- Gravedad ---
g                       (0 0 0)   m/s2  # deshabilitada


################################################################################
# 3. MALLA (MESH)
################################################################################

# --- Region fluido (1 bloque hex) ---
Nx_fluido               50              # direccion X
Ny_fluido               50              # direccion Y
Nz_fluido               400             # direccion Z
Celdas_fluido           1000000         # 50 x 50 x 400

Grading_X   (0.2_0.3_10) (0.7_0.4_1) (0.2_0.3_0.1)   # fino en paredes, relacion 10:1
Grading_Y   (0.2_0.3_10) (0.7_0.4_1) (0.2_0.3_0.1)   # fino en paredes, relacion 10:1
Grading_Z   uniforme (1)

# --- Region solido (16 bloques hex: 8 adiabaticos + 8 calentados) ---
Nx_pared                10
Nx_canal_solido         50
Ny_pared                10
Ny_canal_solido         50
Nz_seccion_adiabatica   80             # 80 celdas en La=1.2 mm
Nz_seccion_calentada    320            # 320 celdas en Lh=8.8 mm
Grading_solido          uniforme (1 1 1) en todos los bloques

# Conteo por bloque (seccion adiabatica, Nz=80):
#   base-izq:         10 x 10 x  80 =   8,000
#   base-centro:      50 x 10 x  80 =  40,000
#   base-der:         10 x 10 x  80 =   8,000
#   tapa-izq:         10 x 10 x  80 =   8,000
#   tapa-centro:      50 x 10 x  80 =  40,000
#   tapa-der:         10 x 10 x  80 =   8,000
#   pared-lat-izq:    10 x 50 x  80 =  40,000
#   pared-lat-der:    10 x 50 x  80 =  40,000
#   Subtotal adiabatico              = 192,000
# (seccion calentada = 4x adiabatica por Nz 320 vs 80)
#   Subtotal calentado               = 768,000
Celdas_solido_adiabatico   192000
Celdas_solido_calentado    768000
Celdas_solido_total        960000

Celdas_total_simulacion    1960000      # fluido + solido

# --- Escala de coordenadas en blockMeshDict ---
scale                   0.001          # coordenadas en mm


################################################################################
# 4. PROPIEDADES FISICAS - FLUIDO (agua liquida, fase principal)
################################################################################

# Modelo termodinamico: heRhoThermo / pureMixture / Boussinesq

nombre_fase_liquida     water
Modelo_termofisico_liq  heRhoThermo + Boussinesq
Energia_liq             sensibleInternalEnergy
Transporte_liq          const

M_agua                  18.0          g/mol
rho0_agua               998.2         kg/m3    # densidad de referencia
T0_referencia_agua      373.15        K        # temperatura de referencia (Boussinesq)
beta_agua               6.90e-4       1/K      # coeficiente expansion termica
Cp_agua                 4182.0        J/(kg.K)
mu_agua                 1.003e-3      Pa.s     # viscosidad dinamica
Pr_agua                 6.99          -        # numero de Prandtl
Hf_agua                 0             J/kg
lambda_agua             0.600         W/(m.K)  # calculado: mu*Cp/Pr
nu_agua                 1.005e-6      m2/s     # calculado: mu/rho0
alpha_termica_agua      1.437e-7      m2/s     # calculado: lambda/(rho0*Cp)



################################################################################
# 5. PROPIEDADES FISICAS - SOLIDO (silicio)
################################################################################

Modelo_termofisico_sol  heSolidThermo / pureMixture / constIso
Energia_sol             sensibleEnthalpy

M_silicio               28.085        g/mol
rho_silicio             2330          kg/m3
Cp_silicio              712           J/(kg.K)
kappa_silicio           148           W/(m.K)    # conductividad termica isotropica
alpha_termica_sol       8.95e-5       m2/s       # calculado: kappa/(rho*Cp)
Radiacion_solido        none


################################################################################
# 6. MODELO DE CAMBIO DE FASE
################################################################################

Modelo_masa             hardtWondra
Modelo_energia          implicitGrad
Modelo_macro            directEvaporation (superheated=1)

Tsat                    373.15        K          # temperatura de saturacion
pSat                    101325        Pa         # presion de saturacion (atm)
L_vaporizacion          2.26e6        J/kg       # calor latente de vaporizacion
Tmin_sat                200           K
Tmax_sat                500           K

sigma_tension_sup       0.059         N/m        # tension superficial agua-vapor
Modelo_fuerza_sup       gradAlpha
Modelo_fuerza_grav      gravity
Modelo_delta_func       alphaCSF


################################################################################
# 7. CONDICIONES INICIALES (0-orig-asp)
################################################################################

# --- Fluido ---
U_inicial               (0 0 0.31)    m/s        # campo inicial
T_inicial_fluido        370           K
p_inicial               1.00e5        Pa
p_rgh_inicial           1.00e5        Pa
alpha_water_inicial     1.0           -           # canal lleno de agua (sin vapor)

# --- Solido ---
T_inicial_solido        370           K


################################################################################
# 8. CONDICIONES DE CONTORNO - FLUIDO
################################################################################

# === ENTRADA (inlet) ===
U_inlet_tipo            flowRateInletVelocity
massFlowRate_inlet      2.25e-5       kg/s
extrapolateProfile      yes
T_inlet_tipo            totalTemperature
T0_inlet                370           K
gamma_inlet             1.4
p_inlet_tipo            zeroGradient
p_rgh_inlet_tipo        zeroGradient
alpha_water_inlet       fixedValue    1.0         # liquido puro

# === SALIDA (outlet) ===
U_outlet_tipo           pressureInletOutletVelocity
inletValue_outlet       (0 0 0)
T_outlet_tipo           zeroGradient
p_outlet_tipo           totalPressure
p0_outlet               1.00e5        Pa
rho_outlet              rho
p_rgh_outlet_tipo       totalPressure
p_rgh0_outlet           1.00e5        Pa
alpha_water_outlet      inletOutlet   inletValue=1.0

# === PAREDES FLUIDO-SOLIDO (fluidToSolidBottom/Top/Left/Right) ===
U_paredes_tipo          noSlip
T_paredes_tipo          compressible::turbulentTemperatureRadCoupledMixed
T_valor_inicial_par     370           K
T_Tnbr                  T
T_kappaMethod           fluidThermo
qrNbr                   none
qr                      none
p_paredes_tipo          fixedFluxPressure
alpha_water_paredes     zeroGradient
Tipo_patch_tras_changeDictionary  mappedWall (nearestPatchFace)


################################################################################
# 9. CONDICIONES DE CONTORNO - SOLIDO
################################################################################

# === BASE EXTERIOR CALENTADA (solidBottom, z = 0 a 10.0 mm) ===
T_solidBottom_tipo            externalWallHeatFluxTemperature
q_solidBottom                 100000        W/m2   # 100 kW/m2
T_solidBottom_ini             373.15        K
kappaMethod_solidBottom       solidThermo

# === PAREDES LATERALES (simetria) ===
solidLeft_tipo                symmetryPlane
solidRight_tipo               symmetryPlane

# === TAPA SUPERIOR ===
solidTop_tipo                 zeroGradient

# === EXTREMOS AXIALES (front, back) ===
front_tipo                    zeroGradient
back_tipo                     zeroGradient

# === INTERFACES SOLIDO-FLUIDO (solidToFluidBottom/Top/Left/Right) ===
T_interfaz_sol_tipo           compressible::turbulentTemperatureRadCoupledMixed
T_interfaz_sol_ini            370           K
T_interfaz_Tnbr               T
kappaMethod_interfaz_sol      solidThermo
Tipo_patch_tras_changeDictionary  mappedWall (nearestPatchFace, sampleRegion=fluid)


################################################################################
# 10. CONTROL DE TIEMPO
################################################################################

startFrom               latestTime
startTime               0             s
stopAt                  endTime
endTime                 0.1           s
deltaT_inicial          1.00e-8       s
maxDeltaT               4.00e-6       s
writeControl            adjustableRunTime
writeInterval           5.00e-3       s       # 20 instantes de escritura en 0.1 s
purgeWrite              10            -       # conserva solo los 10 ultimos tiempos
writeFormat             binary
writePrecision          8
writeCompression        off
timePrecision           10
runTimeModifiable       yes
adjustTimeStep          yes
maxCo                   0.1999        -
maxAlphaCo              0.1999        -
maxDi                   100           -
maxCapillaryNum         1             -


################################################################################
# 11. ESQUEMAS NUMERICOS - FLUIDO (system/fluid/fvSchemes)
################################################################################

ddt_fluido              backward
grad_default            cellLimited Gauss linear 0.5
grad_U                  faceLimited Gauss linear 1.0
div_phi_U               Gauss linearUpwind grad(U)
div_phi_K               Gauss linear
div_R                   Gauss linear
div_rhoCpLPhi_Twater    Gauss linearUpwind grad(U)
div_rhoCpVPhi_Tair      Gauss linearUpwind grad(U)
div_rhoPhi_U            Gauss linearUpwind grad(U)
div_rhoPhi_T            Gauss linearUpwind grad(U)
laplacian_fluido        Gauss linear limited 0.80
snGrad_fluido           limited corrected 0.80
interpolacion_fluido    linear
fluxRequired            p_rgh


################################################################################
# 12. ESQUEMAS NUMERICOS - SOLIDO (system/solid/fvSchemes)
################################################################################

ddt_solido              backward
grad_solido             Gauss linear
div_solido              Gauss linear
laplacian_solido        Gauss linear limited 0.80
snGrad_solido           limited corrected 0.80
interpolacion_solido    linear


################################################################################
# 13. SOLVERS LINEALES - FLUIDO (system/fluid/fvSolution)
################################################################################

# alpha.water
alpha_solver            smoothSolver / symGaussSeidel
alpha_nAlphaCorr        4
alpha_nAlphaSubCycles   4
alpha_cAlpha            2
alpha_MULESCorr         yes
alpha_nLimiterIter      5
alpha_tolerance         1e-8
alpha_advectionScheme   isoAdvection
alpha_reconstructionScheme  isoAlpha
alpha_vof2IsoTol        1e-8
alpha_surfCellTol       1e-6
alpha_snapTol           1e-10

# p_rgh
p_rgh_solver            GAMG / DIC
p_rgh_tolerance         1e-6
p_rgh_relTol            1e-4
p_rgh_minIter           3
p_rghFinal_tolerance    1e-7
p_rghFinal_relTol       0

# rho
rho_solver              PCG / DIC
rho_tolerance           1e-6
rho_relTol              1e-4
rhoFinal_tolerance      1e-7

# U, h, T (campo general)
Uh_solver               smoothSolver / symGaussSeidel
Uh_tolerance            1e-7
Uh_relTol               1e-5
Uh_minIter              10
UhFinal_tolerance       5e-8
UhFinal_relTol          0

# Factores de relajacion - campos
relax_p                 0.72
relax_p_rgh             0.72
relax_rho               0.80
relax_h                 0.80
relax_T                 0.70
relax_U                 0.87
relax_alpha             0.50
relax_k_epsilon         0.70

# PIMPLE (fluido)
PIMPLE_momentumPredictor    yes
PIMPLE_nCorrectors          5
PIMPLE_nOuterCorrectors     4
PIMPLE_nNonOrthCorr         2
PIMPLE_pMinFactor           0.5
PIMPLE_pMaxFactor           1.8
PIMPLE_residualControl_p    1e-4
PIMPLE_residualControl_U    1e-5
PIMPLE_residualControl_h    1e-4


################################################################################
# 14. SOLVERS LINEALES - SOLIDO (system/solid/fvSolution)
################################################################################

# p_rgh (solido)
p_rgh_sol_solver        GAMG / GaussSeidel
p_rgh_sol_tolerance     1e-7
p_rgh_sol_relTol        0.01
p_rgh_sol_minIter       10
p_rgh_sol_maxIter       50

# U, h, T (solido)
Uh_sol_solver           smoothSolver / symGaussSeidel
Uh_sol_tolerance        1e-7
Uh_sol_relTol           0
Uh_sol_minIter          10
UhFinal_sol_tolerance   5e-8

# PIMPLE (solido)
PIMPLE_sol_nCorrectors          8
PIMPLE_sol_nNonOrthCorr         0
PIMPLE_sol_momentumPredictor    yes

# Relajacion (solido)
relax_h_sol             1.0
relax_U_sol             1.0


################################################################################
# 15. TURBULENCIA
################################################################################

simulationType          laminar        # sin modelo de turbulencia

################################################################################
# FIN DEL ARCHIVO
################################################################################
