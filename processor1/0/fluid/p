FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/fluid";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 101325;

boundaryField
{
    inlet
    {
        type            calculated;
        value           nonuniform List<scalar> 0;
    }
    outlet
    {
        type            calculated;
        value           uniform 101325;
    }
    outerRight
    {
        type            symmetryPlane;
    }
    outerLeft
    {
        type            symmetryPlane;
    }
    fluid_to_solid
    {
        type            calculated;
        value           uniform 101325;
    }
    procBoundary1to0
    {
        type            processor;
        value           uniform 101325;
    }
}


