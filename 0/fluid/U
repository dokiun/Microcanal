FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       volVectorField;
    location    "0/fluid";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0.61);

boundaryField
{
    inlet
    {
        type            flowRateInletVelocity;
        massFlowRate    constant 1.21e-05;
        extrapolateProfile yes;
        value           uniform (0 0 1.21e-05);
    }
    outlet
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }
    fluidToSolidBottom
    {
        type            noSlip;
    }
    fluidToSolidLeft
    {
        type            noSlip;
    }
    fluidToSolidTop
    {
        type            noSlip;
    }
    fluidToSolidRight
    {
        type            noSlip;
    }
}


