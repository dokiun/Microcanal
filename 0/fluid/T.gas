FoamFile
{
    version 2.0;
    format ascii;
    class volScalarField;
    object T.gas;
}

dimensions [0 0 0 1 0 0 0];
internalField uniform 373.15;
boundaryField
{
    outerLeft
    {
        type symmetryPlane;
    }
    outerRight
    {
        type symmetryPlane;
    }
    inlet
    {
        type fixedValue; 
        value uniform 373.15; \\ temp. de saturacion
    }
    outlet
    {
        type inletOutlet; \\ entra y sale
        phi phi.gas; 
        inletValue uniform 373.15; 
        value uniform 373.15;
    }
    fluid_to_solid
    {
        type            compressible::turbulentTemperatureTwoPhaseRadCoupledMixed; \\ la misma de liquig
        Tnbr            T;
        kappaMethod     phaseSystem;
        region          fluid;
        otherPhase      liquid; \\la otra fase como se llama
        qrNbr           none;
        qr              none;
        value           uniform 373.15;
    }
}


