FoamFile
{
    version 2.0;
    format ascii;
    class volScalarField;
    object T.gas;
}

dimensions [0 0 0 1 0 0 0];
internalField uniform 373.15;
boundaryField
{
    outerLeft
    {
        type symmetryPlane;
    }
    outerRight
    {
        type symmetryPlane;
    }
    inlet
    {
        type fixedValue; value uniform 373.15;
    }
    outlet
    {
        type inletOutlet; phi phi.gas; inletValue uniform 373.15; value uniform 373.15;
    }
    fluid_to_solid
    {
        type copiedFixedValue; sourceFieldName T.liquid; value uniform 373.15;
    }
}
