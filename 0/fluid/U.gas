FoamFile
{
    version 2.0;
    format ascii;
    class volVectorField;
    object U.gas;
}

dimensions [0 1 -1 0 0 0 0];

internalField uniform (0 0 0); // el gas se genera por evaporacion y no entra por la entrada

boundaryField
{
    outerLeft
    {
        type symmetryPlane;
    }

    outerRight
    {
        type symmetryPlane;
    }

    inlet
    {
        type fixedValue;
        value uniform (0 0 0);
    }

    outlet
    {
        type pressureInletOutletVelocity;
        phi phi.gas;
        value uniform (0 0 0);
    }

    fluid_to_solid
    {
        type noSlip;
    }
}
