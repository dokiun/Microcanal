FoamFile
{
    version 2.0;
    format ascii;
    class volScalarField;
    object p_rgh;
}

dimensions [1 -1 -2 0 0 0 0];
internalField uniform 101325;
boundaryField
{
    outerLeft
    {
        type symmetryPlane;
    }
    outerRight
    {
        type symmetryPlane;
    }
    inlet
    {
        type fixedFluxPressure; 
        value uniform 101325;
    }
    outlet
    {
        type prghPressure; rho rho;
        p uniform 101325; 
        value uniform 101325;
    }
    fluid_to_solid
    {
        type zeroGradient; \\ zeroGradient, pero ya está en un U ya coloca noslipt
        value uniform 101325;
    }
}

\\ fixedFluxPresesure: ajusta la presión dependiendo del flujo de velocidad 
