FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/solid";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 300;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }
    outlet
    {
        type            zeroGradient;
    }
    outerBottom
    {
        // La condicion original se conserva comentada como referencia:
        // type            externalWallHeatFluxTemperature;
        // mode            flux;
        // q               uniform 1000000;
        // kappaMethod     solidThermo;
        // kappa           none;
        //
        // OpenFOAM 2506 no registra externalWallHeatFluxTemperature.
        // fixedGradient es la condicion compatible y sigue siendo fisicamente
        // equivalente: impone el mismo flujo q mediante dT/dn = q/k.
        // q = 1e6 W/m2, k = 130 W/(m K), dT/dn = 7692.307692 K/m.
        type            fixedGradient;
        gradient        uniform 7692.307692;
        value           uniform 300;
    }
    outerRight
    {
        type            symmetryPlane;
    }
    outerTop
    {
        type            zeroGradient;
    }
    outerLeft
    {
        type            symmetryPlane;
    }
    solid_to_fluid
    {
        type            compressible::turbulentTemperatureTwoPhaseRadCoupledMixed;
        Tnbr            T.liquid;
        region          solid;
        otherPhase      gas;
        kappaMethod     solidThermo;
        qrNbr           none;
        qr              none;
        kappa           none;
        value           uniform 300;
    }
}

