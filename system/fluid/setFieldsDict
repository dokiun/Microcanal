FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system/fluid";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue T 372.15
    volScalarFieldValue T.air 372.15
    volScalarFieldValue T.water 372.15
);

regions
(
    sphereToCell
    {
        centre (0.000125 0.0001 0.0018);
        radius 0.00005;
        fieldValues
        (
            volScalarFieldValue alpha.water 0
            volScalarFieldValue p_rgh 104725
            volScalarFieldValue p 104725
            volScalarFieldValue T.air 375
            volScalarFieldValue T.water 375
        );
    }
);


