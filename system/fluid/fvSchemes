FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default backward; // Euler;
}

gradSchemes
{
    //default         Gauss linear;
    default cellLimited Gauss linear 0.5;
    grad(U) faceLimited Gauss linear 1.0;
}

divSchemes
{
    default         Gauss linear;

    div(phi,U)                          Gauss linearUpwind grad(U);
    div(phi,K)                          Gauss linear;
    //div(phi,h)                          Gauss linearUpwind grad(U);
    //div(phi,k)                          Gauss linearUpwind grad(U);
    //div(phi,epsilon)                    Gauss linearUpwind grad(U);
    div(phi,R)                          Gauss linearUpwind grad(U);
    div(R)                              Gauss linear;
    div(((rho*nuEff)*dev2(T(grad(U))))) Gauss linear;
    div(phiv,p)                         Gauss linear;
    div(phi,e)                          Gauss linearUpwind grad(U);
    div(rhoCpLPhi,T.water)              Gauss linearUpwind grad(U);
    div(rhoCpVPhi,T.air)                Gauss linearUpwind grad(U);
    div(rhoPhi,U)                       Gauss linearUpwind grad(U);
    div(rhoPhi,T)                       Gauss linearUpwind grad(U);
    div(rhoPhi,K)                       Gauss linearUpwind grad(U);
}

laplacianSchemes
{
    default          Gauss linear limited 0.80;
    //default        Gauss linear uncorrected;
    //default         Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default       limited corrected 0.80;
    //default         corrected;
    //default         uncorrected;
}

fluxRequired
{
    p_rgh;
}

