FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    alpha.water
    {
        nAlphaCorr      4;
        nAlphaSubCycles 4;
        cAlpha          2;

        MULESCorr       yes;
        nLimiterIter    5;

        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0;
        advectionScheme isoAdvection;
        reconstructionScheme isoAlpha;
        vof2IsoTol 1e-8;
        surfCellTol 1e-6;
        snapTol     1e-10;
        writeVTK true;
    }

    psiFinal
    {
        solver           PCG;
        preconditioner   DIC;
        tolerance        1e-7;
        relTol           0.00;
    }

    rhoCpLFinal
    {
        solver           diagonal;
        preconditioner   DILU;
        tolerance        1e-7;
        relTol           0.1;
    }

    rhoCpVFinal
    {
        solver           diagonal;
        preconditioner   DILU;
        tolerance        1e-7;
        relTol           0.1;
    }

    rho
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-6;
        relTol          1e-4;
    }

    rhoFinal
    {
        $rho;
        tolerance       1e-7;
        relTol          0;
    }

    p_rgh
    {
        solver           GAMG;
        tolerance        1e-6;
        relTol           1e-4;
        smoother         DIC;
        minIter		 3;
       // maxIter	 15;
    }

    p_rghFinal
    {
        $p_rgh;
        tolerance        1e-7;
        relTol		 0;
        minIter 3;
        //maxIter 20;
    }

    "(U|h|T.*|k|epsilon|R)"
    {
        solver           smoothSolver; //PBiCGStab;
        smoother         symGaussSeidel;
        //preconditioner   DILU;
        tolerance         1e-7;
        relTol            1e-5;
        minIter          10;
        //maxIter          100;
    }

    "(U|h|T.*|k|epsilon|R)Final"
    {
        $U;
        tolerance        5e-8;
        relTol           0;
        //maxIter          100;
    }
}

PIMPLE
{
    momentumPredictor   yes;
    nCorrectors         5;
    nOuterCorrectors    4;
    nNonOrthogonalCorrectors 2;
    pMinFactor      0.5;
    pMaxFactor      1.8;

    residualControl
    {
        p               1e-4;
        U               1e-5;
        h               1e-4;
    }
}

relaxationFactors
{
    fields
    {
        p               0.72;
        p_rgh           0.72;
        rho             0.80;
    }
    equations
    {
        "h.*"           0.80;
	T		0.70;
        "U.*"           0.87;
        U               0.87;
	"(alpha.*)"	0.5;
        "(k|epsilon)"   0.70;
    }
}

