FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      probes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
 
probesFluid
{
    type            probes;
    libs            (sampling); // ("libsampling.so");
    writeControl    timeStep;
    writeInterval   1;
    interpolationScheme cell;
    region          fluid;
    fields          (T alpha.water);

    // Línea central del canal: X=Y=0.00015 m (centro de sección 200x200 µm)
    probeLocations
    (
        (0.00015  0.00015  0.0005)   // z=0.5 mm  (sección adiabática)
        (0.00015  0.00015  0.001)    // z=1.0 mm  (sección adiabática)
        (0.00015  0.00015  0.0015)   // z=1.5 mm  (inicio sección calentada)
        (0.00015  0.00015  0.002)    // z=2.0 mm
        (0.00015  0.00015  0.0025)   // z=2.5 mm
        (0.00015  0.00015  0.003)    // z=3.0 mm
        (0.00015  0.00015  0.0035)   // z=3.5 mm
        (0.00015  0.00015  0.004)    // z=4.0 mm
        (0.00015  0.00015  0.0045)   // z=4.5 mm
    );
}

probesSolid
{
    type            probes;
    libs            (sampling); // ("libsampling.so");
    writeControl    timeStep;
    writeInterval   1;
    interpolationScheme cell;
    region          solid;
    fields          (T);

    // Pared inferior del sólido (cobre): Y=0.000025 m = mitad del espesor (50 µm), X=centro canal
    probeLocations
    (
        (0.00015  0.000025  0.0005)   // z=0.5 mm  (sección adiabática)
        (0.00015  0.000025  0.0025)   // z=2.5 mm  (sección calentada)
        (0.00015  0.000025  0.0035)   // z=3.5 mm
        (0.00015  0.000025  0.0045)   // z=4.5 mm
    );
}


