FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system/solid";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "(h|T|e)"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-8;
        relTol          0;
    }

    "(h|T|e)Final"
    {
        $h;
        tolerance       1e-8;
        relTol          0;
    }
}

// ************************************************************************* //
PIMPLE { nNonOrthogonalCorrectors 0; }
