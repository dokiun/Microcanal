FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system/solid";
    object      changeDictionaryDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dictionaryReplacement
{
    boundary
    {
        outerLeft
        {
            type symmetryPlane;
            inGroups 1 (symmetryPlane);
        }
        outerRight
        {
            type symmetryPlane;
            inGroups 1 (symmetryPlane);
        }
        solid_to_fluid
        {
            type            mappedWall;
            inGroups        1 ( wall );
            sampleMode      nearestPatchFace;
            sampleRegion    fluid;
            samplePatch     fluid_to_solid;
        }
    }
}

