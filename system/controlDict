FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object controlDict;
}

application chtMultiRegionTwoPhaseEulerFoam;
startFrom startTime;
startTime 0;
stopAt endTime;
endTime 0.0150;
deltaT 1e-4;
writeControl adjustableRunTime;
writeInterval 1e-4;
purgeWrite 0;
writeFormat ascii;
writePrecision 10;
writeCompression on;
timeFormat general;
timePrecision 10;
runTimeModifiable yes;
adjustTimeStep yes;
maxCo 0.195;
maxDi 10;
maxDeltaT 1e-4;
libs ("libthermoTools.so");

functions
{
    #include "dataReduction"
    #include "cuttingPlanes"

    ReynoldsLocal
    {
        type            exprField;
        libs            (fieldFunctionObjects);
        region          fluid;
        field           ReDh;
        action          new;
        autowrite       true;
        executeControl  writeTime;
        writeControl    writeTime;
        readFields      (U.liquid T.liquid rho.liquid);
        // mu(T) correlation for liquid water, Pa s, 300-373 K.
        // ReDh = rho*|U|*Dh/mu(T), Dh = 200 micrometres.
        expression      "rho.liquid*mag(U.liquid)*0.0002/exp(-3.7188 + 578.919/(T.liquid - 137.546))";
        dimensions      [0 0 0 0 0 0 0];
    }
}
