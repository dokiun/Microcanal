FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     multiRegionPhaseChangeFlow;
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         0.0015; //0.042; //1.0;
deltaT          1.00e-8;
writeControl    adjustableRunTime;
writeInterval   1.0e-4;
purgeWrite      0;
writeFormat     binary;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   10;
runTimeModifiable yes;
adjustTimeStep  yes;
maxCo           0.195;
maxAlphaCo      0.195;
maxDeltaT       5.00e-7; //4.00e-6;
maxDi           50;
maxCapillaryNum 1;

libs
(
    "libpostProcess.so"
    "libfluidThermo.so"
	"libOpenFOAM.so"
);

functions
{
	#include "probes"
    #include "cuttingPlanes"
}


