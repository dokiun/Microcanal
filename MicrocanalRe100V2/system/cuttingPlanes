cuttingPlanesFluid
{
    type surfaces; libs (sampling); region fluid;
    writeControl writeTime; surfaceFormat vtk;
    fields (p U.liquid U.gas T.liquid T.gas alpha.gas);
    surfaces
    {
        midplane { type cuttingPlane; planeType pointAndNormal;
            pointAndNormalDict { point (0 0 0.005); normal (0 1 0); }
            interpolate true;
        }
        crossSection { type cuttingPlane; planeType pointAndNormal;
            pointAndNormalDict { point (0 0 0.0025); normal (0 0 1); }
            interpolate true;
        }
        rightSymmetry { type cuttingPlane; planeType pointAndNormal;
            pointAndNormalDict { point (0.00014 0 0); normal (1 0 0); }
            interpolate true;
        }
    }
}
