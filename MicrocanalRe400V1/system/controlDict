FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     chtMultiRegionTwoPhaseEulerFoam;
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         0.1; //0.042; //1.0;
deltaT          1.00e-8;
writeControl    adjustableRunTime;
writeInterval   1e-2;
purgeWrite      10;
writeFormat     binary;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   10;
runTimeModifiable yes;
adjustTimeStep  yes;
maxCo           0.1999;
maxAlphaCo      0.1999;
maxDeltaT       4.00e-6; //4.00e-6;
maxDi           100;
maxCapillaryNum 1;

libs
(
);

functions
{
    #include "dataReduction"
    #include "cuttingPlanes"

    ReynoldsLocal
    {
        type            exprField;
        libs            (fieldFunctionObjects);
        region          fluid;
        field           ReDh;
        action          new;
        autowrite       true;
        executeControl  writeTime;
        writeControl    writeTime;
        readFields      (U.liquid T.liquid rho.liquid);
        // mu(T) correlation for liquid water, Pa s, 300-373 K.
        // ReDh = rho*|U|*Dh/mu(T), Dh = 200 micrometres.
        expression      "rho.liquid*mag(U.liquid)*0.0002/exp(-3.7188 + 578.919/(T.liquid - 137.546))";
        dimensions      [0 0 0 0 0 0 0];
    }
}
