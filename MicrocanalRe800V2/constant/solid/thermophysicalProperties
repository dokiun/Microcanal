FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heSolidThermo;       // Termodinámica para un sólido.
    mixture         pureMixture;         // El sólido se considera silicio puro.
    transport       constIso;            // Conductividad isotrópica constante.
    thermo          hConst;              // Calor específico constante.
    equationOfState rhoConst;            // Densidad constante.
    specie          specie;              // Propiedades de la especie sólida.
    energy          sensibleEnthalpy;    // Variable energética: entalpía sensible.
}

mixture
{
    // Silicio con propiedades constantes.
    // A 300 K: k = 1.3 W/(cm K), Cp = 0.7 J/(g K).
    // Densidad aproximada: 2.329 g/cm3.
    specie
    {
        // Masa molecular del silicio [kg/kmol].
        molWeight 28.0855;
    }

    transport
    {
        // Conductividad térmica isotrópica constante [W/(m K)].
        kappa 130;
    }

    thermodynamics
    {
        // Entalpía de formación de referencia [J/kg].
        Hf 0;

        // Calor específico constante [J/(kg K)].
        Cp 700;
    }

    equationOfState
    {
        // Densidad constante del silicio [kg/m3].
        rho 2329;
    }
}
// ************************************************************************* //
