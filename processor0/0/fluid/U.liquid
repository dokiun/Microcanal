FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       volVectorField;
    location    "0/fluid";
    object      U.liquid;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 3.4181527);

boundaryField
{
    inlet
    {
        type            flowRateInletVelocity;
        massFlowRate    constant 0.00020472;
        rhoInlet        997;
        value           uniform (0 0 3.4181527);
    }
    outlet
    {
        type            pressureInletOutletVelocity;
        phi             phi.liquid;
        value           nonuniform List<vector> 0;
    }
    outerRight
    {
        type            symmetryPlane;
    }
    outerLeft
    {
        type            symmetryPlane;
    }
    fluid_to_solid
    {
        type            noSlip;
    }
    procBoundary0to1
    {
        type            processor;
        value           uniform (0 0 3.4181527);
    }
}


