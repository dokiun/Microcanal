// ============================================================================
// FUNCIONES DE POSTPROCESO - NUEVO
// Malla actual: MicrocanalRe100V2
// Nombres de patch ajustados a la malla generada en esta carpeta.
// Solo quedan las funciones necesarias para monitorizar flujo, calor y salida.
// ============================================================================

__globalTpl
{
    libs            (fieldFunctionObjects);
    writeControl    runTime;
    writeInterval   0.0005;
    log             false;
    writeFields     false;
}

// ============================================================================
// 1. RESIDUOS
// ============================================================================

residualsFluid
{
    type            solverInfo;
    libs            (utilityFunctionObjects);
    region          fluid;
    fields          (U p_rgh h);
    writeResidualFields no;
}

residualsSolid
{
    type            solverInfo;
    libs            (utilityFunctionObjects);
    region          solid;
    fields          (h);
    writeResidualFields no;
}

// ============================================================================
// 2. PRESIONES
// ============================================================================

pInlet
{
    type            surfaceFieldValue;
    libs            (fieldFunctionObjects);
    writeControl    runTime;
    writeInterval   0.0005;
    region          fluid;
    regionType      patch;
    name            inlet;
    operation       areaAverage;
    fields          (p);
}

pOutlet
{
    type            surfaceFieldValue;
    libs            (fieldFunctionObjects);
    writeControl    runTime;
    writeInterval   0.0005;
    region          fluid;
    regionType      patch;
    name            outlet;
    operation       areaAverage;
    fields          (p);
}

