// ============================================================================
// 7. FLUJO DE CALOR EN LA INTERFAZ
// ============================================================================

wallHeatFluxFluid
{
    type            wallHeatFlux;
    libs            (fieldFunctionObjects);
    region          fluid;
    patches         (fluid_to_solid);
    executeControl  writeTime;
    writeControl    writeTime;
    log             false;
}

// ============================================================================
// 8. DATOS RAW DE LA INTERFAZ
// ============================================================================

interfaceRaw
{
    type            surfaces;
    libs            (sampling);
    region          fluid;
    writeControl    writeTime;
    surfaceFormat   raw;
    fields          (T wallHeatFlux);

    surfaces
    (
        fluid_to_solid
        {
            type        patch;
            patches     (fluid_to_solid);
            interpolate false;
        }
    );
}

