FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default backward; // Euler;
}

gradSchemes
{
    //default         Gauss linear;
    default cellLimited Gauss linear 0.5;
}

divSchemes
{
    div(phi,alpha)              Gauss vanLeer;
    div(phirb,alpha)            Gauss linearUpwind grad(U);

    div(phi,thermo:rho.water)   Gauss linearUpwind grad(U);
    div(phi,thermo:rho.air)     Gauss linearUpwind grad(U);
}

laplacianSchemes
{
    default          Gauss linear limited 0.80;
    //default        Gauss linear uncorrected;
    //default         Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default       limited corrected 0.80;
    //default         corrected;
    //default         uncorrected;
}

