FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default backward; // Euler;
}

gradSchemes
{
    default         Gauss linear;
}

divSchemes
{
    default         Gauss linear;

}

laplacianSchemes
{
    default          Gauss linear limited 0.80;
    //default        Gauss linear uncorrected;
    //default         Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default       limited corrected 0.80;
    //default         corrected;
    //default         uncorrected;
}

fluxRequired
{
    p_rgh;
}

