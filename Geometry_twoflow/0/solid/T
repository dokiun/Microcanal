FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/solid";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 300;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }
    outlet
    {
        type            zeroGradient;
    }
    outerBottom
    {
        type            externalWallHeatFluxTemperature;
        mode            flux;
        q               uniform 1000000;
        kappaMethod     solidThermo;
        kappa           none;
        value           uniform 300;
    }
    outerRight
    {
        type            symmetryPlane;
    }
    outerTop
    {
        type            zeroGradient;
    }
    outerLeft
    {
        type            symmetryPlane;
    }
    solid_to_fluid
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;
        Tnbr            T;
        kappaMethod     solidThermo;
        qrNbr           none;
        qr              none;
        kappa           none;
        value           uniform 300;
    }
}


