cuttingPlanesFluid
{
    type surfaces;
    libs (sampling);
    region fluid;
    writeControl adjustableRunTime;
    writeInterval 0.0004166666667;
    surfaceFormat vtk;
    fields (p U T);
    surfaces
    {
        inlet
        {
            type cuttingPlane;
            planeType pointAndNormal;
            pointAndNormalDict { point (0 0 0); normal (0 0 1); }
            interpolate true;
        }
        outlet
        {
            type cuttingPlane;
            planeType pointAndNormal;
            pointAndNormalDict { point (0 0 0.005); normal (0 0 1); }
            interpolate true;
        }
        bottom
        {
            type cuttingPlane;
            planeType pointAndNormal;
            pointAndNormalDict { point (0 -0.00015 0); normal (0 1 0); }
            interpolate true;
        }
        top
        {
            type cuttingPlane;
            planeType pointAndNormal;
            pointAndNormalDict { point (0 0.00015 0); normal (0 1 0); }
            interpolate true;
        }
        left
        {
            type cuttingPlane;
            planeType pointAndNormal;
            pointAndNormalDict { point (-0.00015 0 0); normal (1 0 0); }
            interpolate true;
        }
        right
        {
            type cuttingPlane;
            planeType pointAndNormal;
            pointAndNormalDict { point (0.00015 0 0); normal (1 0 0); }
            interpolate true;
        }
    }
}

