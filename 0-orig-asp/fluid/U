FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volVectorField;
    location    "0/fluid";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0.31);

boundaryField
{
    fluidToSolidTop
    {
        type noSlip;
    }

    fluidToSolidBottom
    {
        type noSlip;
    }

    fluidToSolidLeft
    {
        type noSlip;
    }

    fluidToSolidRight
    {
        type noSlip;
    }

    inlet
    {
        type                flowRateInletVelocity;
        massFlowRate        1.21e-5; 
        extrapolateProfile  yes;
        value               uniform (0 0 1.21e-5);
        //type    fixedValue;
        //value   uniform (0 0 0.31);
    }

    outlet
    {
        type        pressureInletOutletVelocity;
        inletValue  uniform (0 0 0);
        value       uniform (0 0 0);
    }
}

