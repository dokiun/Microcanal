FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/fluid";
    object      alpha.water;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 1.0;

boundaryField
{
    fluidToSolidTop
    {
        type zeroGradient;
    }

    fluidToSolidBottom
    {
        type zeroGradient;
    }

    fluidToSolidLeft
    {
        type zeroGradient;
    }

    fluidToSolidRight
    {
        type zeroGradient;
    }

    inlet
    {
        type 	fixedValue;
	value	uniform 1;
    }

    outlet
    {
        type 		inletOutlet;
	inletValue	uniform 1.0;
	value		uniform 1.0;
    }
}

// ************************************************************************* //
