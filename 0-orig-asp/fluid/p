FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/fluid";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 101235; //1e-5;

boundaryField
{
    fluidToSolidTop
    {
        type            fixedFluxPressure;
        gradient        uniform 0;
        value           uniform 101235;
    }

    fluidToSolidBottom
    {
        type            fixedFluxPressure;
        gradient        uniform 0;
        value           uniform 101235;
    }

    fluidToSolidLeft
    {
        type fixedFluxPressure;
    }

    fluidToSolidRight
    {
        type fixedFluxPressure;
    }

    inlet
    {
        type zeroGradient;
    }

    outlet
    {
        //type            fixedMean;
        //meanValue       constant    1.02e5;
        //rho             rho;
        //value           uniform     1.02e5;
        
        type            totalPressure;
        rho             rho;
        psi             none;
        gamma           1;
        p0              uniform 101235;
        value           uniform 101235;
    }
}

