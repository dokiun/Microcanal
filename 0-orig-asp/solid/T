FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/solid";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 375;

boundaryField
{
    // Sección ADIAATICA (z = 0 a 1.2 mm): sin flujo de calor
    solidBottomAdiabatic
    {
        type            zeroGradient;
    }

    // Sección CALENTADA (z = 1.2 a 6 mm): qw = 400 kW/m²
    solidBottom
    {
        type            externalWallHeatFluxTemperature;
        mode            flux;
        q               uniform 400000;
        kappaMethod     solidThermo;
        kappa           none;
        value           uniform 375;
    }

    solidLeft
    {
        type            zeroGradient;
    }

    solidRight
    {
        type            zeroGradient;
    }

    solidTop
    {
        type            zeroGradient;
    }

    back
    {
        type            zeroGradient;
    }

    front
    {
        type            zeroGradient;
    }

    solidToFluidTop
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;
        value           uniform 376;
        Tnbr            T;
        kappaMethod     solidThermo;
        qrNbr           none;
        qr              none;
        kappa           none;
    }

    solidToFluidBottom
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;
        value           uniform 376;
        Tnbr            T;
        kappaMethod     solidThermo;
        qrNbr           none;
        qr              none;
        kappa           none;
    }

    solidToFluidLeft
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;
        value           uniform 376;
        Tnbr            T;
        kappaMethod     solidThermo;
        qrNbr           none;
        qr              none;
        kappa           none;
    }

    solidToFluidRight
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;
        value           uniform 376;
        Tnbr            T;
        kappaMethod     solidThermo;
        qrNbr           none;
        qr              none;
        kappa           none;
    }

}

